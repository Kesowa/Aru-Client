{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "serve": "vite preview",
    "lock": "npm i --package-lock-only",
    "proxy": "localhost:3000",
    "lint": "eslint",
    "format": "prettier",
    "lint:check": "npm run prettier:check && npm run eslint:check",
    "eslint:check": "eslint . --ext .js,.ts,.jsx,.tsx",
    "prettier:check": "prettier --list-different \"**/*.js\" \"**/*.ts\" \"**/*.tsx\"",
    "lint:fix": "npm run prettier:fix && npm run eslint:fix",
    "eslint:fix": "eslint . --fix --ext .js,.ts,.jsx,.tsx",
    "prettier:fix": "prettier --write \"**/*.js\" \"**/*.ts\" \"**/*.tsx\""
  },
  "dependencies": {
    "@ant-design/pro-layout": "^7.17.6",
    "@deck.gl-community/editable-layers": "^9.0.0-alpha.1",
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@googlemaps/markerclustererplus": "^1.1.2",
    "@luma.gl/constants": "^9.0.15",
    "@turf/turf": "^6.4.0",
    "@uiw/react-json-view": "^2.0.0-alpha.24",
    "antd": "^4.24.10",
    "antd-img-crop": "^3.9.0",
    "array-move": "^3.0.1",
    "axios": "^0.21.2",
    "chart.js": "^4.3.0",
    "chonky": "^2.3.2",
    "chonky-icon-fontawesome": "^2.3.2",
    "classnames": "^2.2.6",
    "date-fns": "^2.21.3",
    "deck.gl": "^9.0.20",
    "downloadjs": "^1.4.7",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "exifreader": "^4.5.0",
    "get-video-duration": "^3.0.2",
    "hls.js": "^1.5.11",
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.0.0-rc.7",
    "less": "^4.1.3",
    "moment": "^2.29.4",
    "prettier": "^2.8.3",
    "qrcode": "^1.4.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-color": "^2.19.3",
    "react-css-theme-switcher": "^0.3.0",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.4",
    "react-error-boundary": "^3.1.4",
    "react-google-recaptcha": "^2.1.0",
    "react-highlight-words": "^0.20.0",
    "react-hls-player": "^3.0.7",
    "react-icons": "^4.7.1",
    "react-infinite-scroll-component": "^6.1.0",
    "react-loading-skeleton": "^3.0.1",
    "react-map-gl": "^6.1.16",
    "react-mentions": "^4.4.8",
    "react-otp-input": "^3.1.1",
    "react-password-checklist": "^1.3.3",
    "react-player": "^2.7.2",
    "react-redux": "^7.2.0",
    "react-router-dom": "^5.2.0",
    "react-sortable-hoc": "^2.0.0",
    "react-static-google-map": "^0.9.0",
    "redux": "^4.2.1",
    "redux-devtools-extension": "^2.13.8",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^2.3.0",
    "screenfull": "^5.1.0",
    "socket.io-client": "^4.5.3",
    "supercluster": "^8.0.1",
    "svg2geojson": "github:Kesowa/svg2geojson",
    "svgpath": "^2.6.0",
    "svgson": "^5.3.1",
    "uuid": "^8.3.2",
    "viewport-mercator-project": "^7.0.4",
    "vtracer-webapp": "file:vtracer-webapp-0.4.0.tgz"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "prefer-const": "warn",
      "no-var": "warn",
      "@typescript-eslint/no-unused-vars": "off",
      "unused-imports/no-unused-imports": "error",
      "unused-imports/no-unused-vars": [
        "warn",
        {
          "vars": "all",
          "varsIgnorePattern": "^_",
          "args": "after-used",
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "@playwright/test": "^1.31.1",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "@testing-library/user-event": "^7.1.2",
    "@types/downloadjs": "^1.4.3",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.11.18",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-highlight-words": "^0.16.1",
    "@types/react-redux": "^7.1.9",
    "@types/react-router-dom": "^5.1.5",
    "@types/redux-logger": "^3.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.2.4",
    "dotenv": "^16.0.3",
    "eslint": "^9.6.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "gulp": "^4.0.2",
    "gulp-csso": "^4.0.1",
    "gulp-debug": "^4.0.0",
    "gulp-less": "^4.0.1",
    "gulp-postcss": "^9.0.0",
    "less-plugin-npm-import": "^2.1.0",
    "rollup": "^4.18.1",
    "rollup-plugin-visualizer": "^5.9.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.2",
    "vite-plugin-svgr": "^4.2.0",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.3.0",
    "vite-tsconfig-paths": "^4.0.5"
  }
}
